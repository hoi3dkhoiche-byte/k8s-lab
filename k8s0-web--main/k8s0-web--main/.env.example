# ==============================================================================
# BIDA CAO CAP - CMC CLOUD CONFIGURATION (.env)
# ==============================================================================

# 1. DATABASE REST API CONFIGURATION
# Trỏ trực tiếp tới Database API của CMC Cloud hoặc Data-API-Service nội bộ
DATABASE_API_URL=http://data-api-service:8000
SECRET_KEY=bida-cao-cap-secret-key-2024

# 2. REDIS CONFIGURATION (REAL-TIME TRADING & INVENTORY)
# Trỏ tới CMC Cloud Managed Redis hoặc Redis container
REDIS_URL=redis://redis-db:6379/0

# 3. CMC CLOUD S3 OBJECT STORAGE (LƯU TRỮ HÌNH ẢNH SẢN PHẨM)
# Thông tin bucket & access credentials từ CMC Telecom / CMC Cloud S3 Console
S3_ENDPOINT_URL=https://s3.cloud.cmctelecom.vn
S3_BUCKET_NAME=bida-caocap-images
S3_ACCESS_KEY=your_cmc_s3_access_key
S3_SECRET_KEY=your_cmc_s3_secret_key
S3_REGION=ap-southeast-1
# Nếu có CDN hoặc custom domain cho S3 CMC (tùy chọn)
S3_PUBLIC_URL_PREFIX=

# 4. KAFKA EVENT STREAMING
KAFKA_BOOTSTRAP=kafka:9092

# 5. BACKEND DATABASE STRINGS (DÙNG CHO DATA-API-SERVICE KHI CHẠY CONTAINER)
POSTGRES_URL=postgresql://admin:admin123@postgres-db:5432/user_db
MYSQL_URL=mysql+pymysql://admin:admin123@mysql-db:3306/order_db
MONGO_URL=mongodb://admin:admin123@mongo-db:27017/
